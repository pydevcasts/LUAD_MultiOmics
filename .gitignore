# ------------------------------------------------------------
# 20. Keep important project files
# ------------------------------------------------------------

# Make sure these can remain tracked even if broad
# patterns above match them.

!requirements.txt
!environment.yml
!README.md

# Example configuration files should be tracked
!configs/
!configs/*.yaml
!configs/*.yml
!configs/experiments/
!configs/experiments/*.yaml
!configs/experiments/*.yml

# Keep source code
!src/
!src/**/*.py

# Keep scripts
!scripts/
!scripts/**/*.py

# Keep tests
!tests/
!tests/**/*.py

# Keep notebook structure/code
!notebooks/
!notebooks/**/*.ipynb

# Keep documentation
!docs/
!docs/**/*.md